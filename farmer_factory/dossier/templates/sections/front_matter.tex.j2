<% for tier, count in d.verification_stats.tier_distribution.items() %>
<< tier | latex_escape >> & << count >> & <% if 'TIER_3' in tier %>AI-extracted, unverified<% elif 'TIER_2_ANALYST' in tier %>Analyst verified<% elif 'TIER_2_INSTITUTIONAL' in tier %>Institutional records<% elif 'TIER_1' in tier %>Certified<% else %>Unknown<% endif %> \\
<% endfor %>
\midrule
\textbf{Total} & << d.verification_stats.total_data_points >> & \\
\bottomrule
\end{tabular}
\end{center}

<% if d.verification_stats.overall_confidence > 0 %>
\begin{center}
\textit{Overall confidence: << "%.1f" | format(d.verification_stats.overall_confidence * 100) >>\%}
\end{center}
<% endif %>

